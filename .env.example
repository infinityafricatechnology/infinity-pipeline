# Serveur
PORT=8300
DATABASE_PATH=data/iat.db
# Adresse publique de l'application (liens donnés à Claude)
PUBLIC_URL=http://localhost:8300
# Adresse du serveur MCP, affichée sur la page « Connecter Claude »
MCP_URL=http://localhost:8311/mcp
# Administrateur, créé au premier démarrage. Sans IAT_ADMIN_PASSWORD, la valeur par défaut de docker-compose.yml s'applique.
IAT_ADMIN_EMAIL=admin@iat.ci
IAT_ADMIN_NAME=Administrateur IAT
IAT_ADMIN_PASSWORD=
