{
  "name": "@iat/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --disable-warning=ExperimentalWarning --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env --disable-warning=ExperimentalWarning src/index.ts",
    "seed": "node --env-file-if-exists=../../.env --disable-warning=ExperimentalWarning src/cli/seed.ts",
    "user": "node --env-file-if-exists=../../.env --disable-warning=ExperimentalWarning src/cli/user.ts",
    "test": "node --disable-warning=ExperimentalWarning --test 'test/**/*.test.ts'",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@hono/zod-openapi": "1.6.3",
    "hono": "4.13.13",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "25.9.9",
    "typescript": "7.0.2"
  }
}
